    table_push(g_lang_names, "한국어")
    table_push(g_lang_banners, "이 페이지의 번역은 아직 제공되지 않습니다. 영어 텍스트가 표시됩니다. 영어 버전이 우선합니다(§15.8).")
    table_push(g_lang_refnotes, "이 페이지는 TPL 2.3의 비공식 참고 번역입니다. 영어 원문이 우선합니다(§15.8).")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "이 페이지는 TPL 2.3의 공식 번역입니다. 영어 원문이 우선합니다(§15.8).")
    table_push(g_lang_codes, "ar")
    table_push(g_lang_names, "العربية")
    table_push(g_lang_banners, "الترجمة غير متوفرة بعد؛ يُعرض النص الإنجليزي. النسخة الإنجليزية هي المعتمدة (§15.8).")
    table_push(g_lang_refnotes, "هذه الصفحة ترجمة مرجعية غير رسمية للـ TPL 2.3. النص الإنجليزي هو المعتمد (§15.8).")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "هذه الصفحة ترجمة رسمية للـ TPL 2.3. النص الإنجليزي هو المعتمد (§15.8).")
}

