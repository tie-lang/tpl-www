        l_faq = "자주 묻는 질문"
        l_about = "소개"
        l_loc = "현지화"
        l_con = "기여"
        l_theme = "밝은 / 어두운 테마 전환"
    }
    if cur == "ar" {
        l_home = "الرئيسية"
        l_text = "النص"
        l_cmp = "مقارنة"
        l_using = "الاستخدام"
        l_faq = "الأسئلة الشائعة"
        l_about = "حول"
        l_loc = "التعريب"
        l_con = "المساهمة"
        l_theme = "تبديل السمة الفاتحة والداكنة"
    }
    sb_append(h, "<nav class=\"top\"><div class=\"brand\"><a href=\"" + home + "\">Tie Public License</a></div><div class=\"links\">")
    sb_append(h, "<a href=\"" + home + "\">" + l_home + "</a>")
    sb_append(h, "<a class=\"on\" href=\"#\">" + l_text + "</a>")
    sb_append(h, "<a href=\"" + home + "compare/\">" + l_cmp + "</a>")
    sb_append(h, "<a href=\"" + home + "using/\">" + l_using + "</a>")
    sb_append(h, "<a href=\"" + home + "faq/\">" + l_faq + "</a>")
    sb_append(h, "<a href=\"" + home + "about/\">" + l_about + "</a>")
    sb_append(h, "<a href=\"" + home + "localization/\">" + l_loc + "</a>")
    sb_append(h, "<a href=\"" + home + "contributing/\">" + l_con + "</a>")
    sb_append(h, "<details class=\"lang\"><summary aria-label=\"Language\">" + lang_icon + "</summary><div class=\"menu\">")
    var n = len(g_lang_codes)
    var i: i64 = 0
    while i < n {
        var lc = g_lang_codes[i]
        if lc != cur {
            sb_append(h, "<a href=\"/" + lc + "/" + ver_suffix + "\">" + g_lang_names[i] + "</a>")
        }
        i = i + 1
    }
    sb_append(h, "</div></details>")
    sb_append(h, "<button class=\"theme\" id=\"themeBtn\" type=\"button\" aria-label=\"" + l_theme + "\"><span class=\"ico-moon\">" + ico_moon + "</span><span class=\"ico-sun\">" + ico_sun + "</span></button>")
    sb_append(h, "</div></nav>\n")
}

// 页面头尾壳
func emit_shell_open(h: i64, title: string, cur: string, ver_suffix: string, zh: bool) {
    var dir_attr = ""
    if cur == "ar" {
        dir_attr = " dir=\"rtl\""
    }
    sb_append(h, "<!DOCTYPE html>\n<html lang=\"" + cur + "\"" + dir_attr + ">\n<head>\n<meta charset=\"utf-8\">\n")
    sb_append(h, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
    sb_append(h, "<title>" + esc_html(title) + "</title>\n")
    sb_append(h, "<meta name=\"description\" content=\"The Tie Public License (TPL) — a permissive, attribution-based open source license published by the TIE-LANG organization.\">\n")
    sb_append(h, "<link rel=\"stylesheet\" href=\"/assets/site.css?v=11\">\n")
    sb_append(h, "<script>(function(){var t;try{t=localStorage.getItem(\"tpl_theme\")}catch(e){}if(t!=\"dark\"&&t!=\"light\"){t=window.matchMedia&&window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\"}document.documentElement.dataset.theme=t})()</script>\n")
    sb_append(h, "</head>\n<body>\n")
    emit_nav(h, cur, ver_suffix, zh)
    sb_append(h, "<main>\n")
}
func emit_shell_close(h: i64, home: string) {
    sb_append(h, "</main>\n")
    sb_append(h, "<footer>Tie Public License · maintained by the TIE-LANG organization · <a href=\"https://github.com/tie-lang/TPL\">text repository</a> · <a href=\"https://github.com/tie-lang/tpl-www\">website repository</a> · <a href=\"" + home + "\">home</a></footer>\n")
    sb_append(h, "<script>var tb=document.getElementById(\"themeBtn\");if(tb){tb.addEventListener(\"click\",function(){var r=document.documentElement,t=r.dataset.theme==\"dark\"?\"light\":\"dark\";r.dataset.theme=t;try{localStorage.setItem(\"tpl_theme\",t)}catch(e){}})}</script>\n")
    sb_append(h, "</body>\n</html>\n")
}

// ---------- 许可证正文转换 ----------

// 行首是否为 4 个空格（附录通知模板等代码型块）——RTL 页面需隔离为 LTR
func is_indented(s: string) -> bool {
    if len(s) < 4 {
        return false
    }
    var i: i64 = 0
    while i < 4 {
        if str_byte(s, i) != 32 {
            return false
        }
        i = i + 1
    }
    return true
}

// 输出一个块：块内行以 \n 连接，条款起始块带 id 锚点
func flush_block(h: i64, blk: table<string>) {
    var cnt = len(blk)
    if cnt == 0 {
        return
    }
    var first = blk[0]
    var id_attr = ""
    if is_clause(first) {
        id_attr = " id=\"" + clause_id(first) + "\""
    }
    var ltr_attr = ""
    if is_indented(first) {
        ltr_attr = " dir=\"ltr\" class=\"tpl-code\""
    }
    sb_append(h, "<p" + id_attr + ltr_attr + ">")
    var j: i64 = 0
    while j < cnt {
        if j > 0 {
            sb_append(h, "\n")
        }
        sb_append(h, blk[j])
        j = j + 1
    }
    sb_append(h, "</p>\n")
}

// 把许可文本行流转换为 HTML 片段（h1 由页头承担，文本自带的前两行标题跳过）
// 追加规则：空行分块 → <p>；标题行 → <h2 id>；条款行强制开新块并带锚点
func emit_body(h: i64, src: string) {
    var lines = split_lines(src)
    var n = len(lines)

    var cur = table_new_string()   // 当前块的行
    var cur_open = false
    var skip_title = true          // 跳过文本自带的 "TIE PUBLIC LICENSE" + "Version X.Y" 两行
    var i: i64 = 0

    while i < n {
        var line = lines[i]
        i = i + 1

        if skip_title {
            if is_blank(line) { continue }
            if has_prefix(line, "TIE PUBLIC LICENSE") { continue }
            if has_prefix(line, "Version ") {
                skip_title = false
                continue
            }
            // 兜底：结构不符就不再跳
            skip_title = false
        }

        if is_blank(line) {
            if cur_open {
                flush_block(h, cur)
                cur = table_new_string()
                cur_open = false
            }
            continue
        }

        if is_heading(line) {
            if cur_open {
                flush_block(h, cur)
                cur = table_new_string()
                cur_open = false
            }
            sb_append(h, "<h2 id=\"" + heading_id(line) + "\">" + esc_html(line) + "</h2>\n")
            continue
        }

        if is_clause(line) && cur_open {
            flush_block(h, cur)
            cur = table_new_string()
            cur_open = false
        }

        table_push(cur, esc_html(line))
        cur_open = true
    }
    if cur_open {
        flush_block(h, cur)
    }
}

// ---------- 版本页生成 ----------

// 生成一个版本的 en 页 + zh 回落页 + 纯文本副本
// src: TPL 仓文本路径；ver/date: 元数据；current: 是否当前版本
// out_root: 站点根目录
func gen_version(src: string, ver: string, date: string, current: bool, out_root: string, xlat_root: string) {
    var body = file_read(src)
    if len(body) < 100 {
        print_err("gen_lic: source too small or unreadable: " + src)
        exit(1)
    }
    var n = len(g_lang_codes)
    var i: i64 = 0
    while i < n {
        var lc = g_lang_codes[i]
        var zh = lc == "zh-cn"
        var dir = out_root + lc + "\\" + ver
        mkdir_all(dir)
        var h = string_builder()
        emit_shell_open(h, "Tie Public License " + ver, lc, ver + "/", zh)
        var banner = g_lang_banners[i]
        var lbody = body
        // 译文源：translations/<lang>/tpl-<ver>.<lang>.txt 存在则启用（无须改本表）
        var xlat = xlat_root + lc + "\\" + "tpl-" + ver + "." + lc + ".txt"
        if file_exists(xlat) {
            lbody = file_read(xlat)
            if g_lang_official[i] == 1 {
                banner = g_lang_official_notes[i]
            } else {
                banner = g_lang_refnotes[i]
            }
        }
        if banner != "" {
            var bcls = "banner"
            if g_lang_official[i] == 1 && file_exists(xlat) {
                bcls = "banner official"
            }
            sb_append(h, "<div class=\"" + bcls + "\">" + banner + "</div>\n")
        }
        sb_append(h, "<div class=\"lic-head\">")
        sb_append(h, "<h1>Tie Public License " + ver + "</h1>")
        sb_append(h, "<p class=\"meta\">")
        if current {
            if zh { sb_append(h, "当前版本") } else { sb_append(h, "Current version") }
        } else {
            if zh { sb_append(h, "历史存档版本") } else { sb_append(h, "Archived version") }
        }
        if zh {
            sb_append(h, " · 发布于 " + date + " · <a href=\"/" + lc + "/" + ver + "/tpl-" + ver + ".txt\">纯文本</a></p>")
        } else {
            sb_append(h, " · published " + date + " · <a href=\"/" + lc + "/" + ver + "/tpl-" + ver + ".txt\">plain text</a></p>")
        }
        sb_append(h, "<p class=\"meta versions\">Versions: ")
        var vs = table_new_string()
        table_push(vs, "2.3")
        table_push(vs, "2.2")
        table_push(vs, "2.1")
        table_push(vs, "2.0")
        var vn = len(vs)
        var j: i64 = 0
        while j < vn {
            var v = vs[j]
            if v != ver {
                sb_append(h, "<a href=\"/" + lc + "/" + v + "/\">" + v + "</a>")
                if j < vn - 1 {
                    sb_append(h, " · ")
                }
            }
            j = j + 1
        }
        sb_append(h, "</p>")
        sb_append(h, "</div>\n")
        sb_append(h, "<div class=\"lic\">\n")
        emit_body(h, lbody)
        sb_append(h, "</div>\n")
        emit_shell_close(h, "/" + lc + "/")
        file_write(dir + "\\index.html", sb_build(h))
        if lc == "en" {
            file_write(dir + "\\tpl-" + ver + ".txt", lbody)
        }
        i = i + 1
    }
    println("[gen] " + ver + " -> " + to_string(n) + " languages + txt (" + to_string(len(body)) + " bytes)")
}

func main() {
    init_langs()
    var root = "F:\\\\Projects\\\\tpl-www\\\\"
    var xroot = "F:\\\\\\\\Projects\\\\\\\\TPL\\\\\\\\translations\\\\\\\\"
    gen_version("F:\\\\Projects\\\\TPL\\\\2.3",    "2.3", "2026-09-29", true,  root, xroot)
    gen_version("F:\\\\Projects\\\\TPL\\\\2.2",    "2.2", "2026-09-25", false, root, xroot)
    gen_version("F:\\\\Projects\\\\TPL\\\\2.1",    "2.1", "2026-09-17", false, root, xroot)
    gen_version("F:\\\\Projects\\\\TPL\\\\2.0",    "2.0", "2026-09-15", false, root, xroot)
    println("[gen] done")
    exit(0)
}