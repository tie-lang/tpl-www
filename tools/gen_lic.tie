type tie<logic>
// gen_lic.tie —— TPL 官网许可证页面生成器（纯 tie，tiec 原生编译运行）
//
// 单一来源原则：站点上的许可证 HTML 一律由本工具从 tie-lang/TPL 仓的
// 文本文件（tpl.txt / 2.2 / 2.1 / 2.0）生成，禁止手抄、禁止手改生成产物。
// 换版流程：TPL 仓双写（tpl.txt + 版本号副本）→ 重跑本工具 → 提交产物。
//
// 编译：tiec --no-cache gen_lic.tie
// 运行：gen_lic.exe   （路径均为绝对路径，与 cwd 无关）
//
// 生成规则：
//   * 行切分按字节扫描（str_byte O(1)），UTF-8 字节原样透传，不做解码
//   * HTML 转义 & < >（其余字节原样）
//   * 空行分块 → <p>（CSS white-space:pre-wrap 保留缩进与换行）
//   * 标题行（前缀判定）→ <h2 id>：PREAMBLE / SECTION N - ... / APPENDIX ... /
//     END OF TERMS AND CONDITIONS；正文里全大写段落（如 §9 的
//     WHERE APPLICABLE LAW...）不是标题，按普通段落保真输出
//   * 条款行 N.N 开头 → <p id="s-N-N">，供 FAQ 等页面深链
//
// 注意：勿用 str_char 访问大串（O(N²)，46KB 级即劣化）；一律 str_byte +
// str_sub_bytes + string_builder。

// 语言切换图标（文/A 翻译徽标，纯文本复合，零外部资源）
// 语言切换图标：Material Design "translate" 标准图标（文/A，现成通用，fill=currentColor 随导航变色）
const lang_icon: string = "<svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" aria-hidden=\"true\" focusable=\"false\"><path fill=\"currentColor\" d=\"M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z\"/></svg>"
// 黑白切换图标：Material "dark_mode"(月) / "light_mode"(日)，与 translate 图标同源
const ico_moon: string = "<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><path fill=\"currentColor\" d=\"M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z\"/></svg>"
const ico_sun: string = "<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" aria-hidden=\"true\" focusable=\"false\"><path fill=\"currentColor\" d=\"M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zm0 8c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z\"/></svg>"

// ---------- 通用字符串工具 ----------

// 整行是否为空白（全字节为空格/制表符）
func is_blank(s: string) -> bool {
    var n = len(s)
    var i: i64 = 0
    while i < n {
        var b = str_byte(s, i)
        if b != 32 && b != 9 {
            return false
        }
        i = i + 1
    }
    return true
}

// HTML 转义一行：& < > → 实体；其余（含 UTF-8 多字节）原样透传
func esc_html(s: string) -> string {
    var h = string_builder()
    var n = len(s)
    var run: i64 = 0
    var i: i64 = 0
    while i < n {
        var b = str_byte(s, i)
        if b == 38 || b == 60 || b == 62 {
            if i > run {
                sb_append(h, str_sub_bytes(s, run, i))
            }
            if b == 38 {
                sb_append(h, "&amp;")
            }
            if b == 60 {
                sb_append(h, "&lt;")
            }
            if b == 62 {
                sb_append(h, "&gt;")
            }
            run = i + 1
        }
        i = i + 1
    }
    if n > run {
        sb_append(h, str_sub_bytes(s, run, n))
    }
    return sb_build(h)
}

// 按字节切行（'\n' 分隔，剥离行尾 '\r'；UTF-8 安全）
func split_lines(s: string) -> table<string> {
    var out = table_new_string()
    var n = len(s)
    var start: i64 = 0
    var i: i64 = 0
    while i <= n {
        // i == n 时收尾最后一段（即使无换行结尾）
        if i == n {
            if i > start {
                var tail = str_sub_bytes(s, start, i)
                var tn = len(tail)
                if tn > 0 && str_byte(tail, tn - 1) == 13 {
                    tail = str_sub_bytes(tail, 0, tn - 1)
                }
                table_push(out, tail)
            }
        } else {
            var b = str_byte(s, i)
            if b == 10 {
                var line = str_sub_bytes(s, start, i)
                var ln = len(line)
                if ln > 0 && str_byte(line, ln - 1) == 13 {
                    line = str_sub_bytes(line, 0, ln - 1)
                }
                table_push(out, line)
                start = i + 1
            }
        }
        i = i + 1
    }
    return out
}

// ---------- 标题与条款识别 ----------

// 前缀判定：s 是否以 prefix 开头
func has_prefix(s: string, prefix: string) -> bool {
    var n = len(s)
    var pn = len(prefix)
    if pn > n {
        return false
    }
    var i: i64 = 0
    while i < pn {
        if str_byte(s, i) != str_byte(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 是否为章节标题行（仅前缀/全等判定，不认全大写——正文有全大写段落）
func is_heading(s: string) -> bool {
    if s == "PREAMBLE" { return true }
    if s == "END OF TERMS AND CONDITIONS" { return true }
    if has_prefix(s, "SECTION ") { return true }
    if s == "APPENDIX" { return true }
    if has_prefix(s, "APPENDIX ") { return true }
    return false
}

// 标题锚点 id：SECTION 12 - ... → section-12；PREAMBLE → preamble；
// APPENDIX ... → appendix；END OF TERMS AND CONDITIONS → end
func heading_id(s: string) -> string {
    if s == "PREAMBLE" { return "preamble" }
    if s == "END OF TERMS AND CONDITIONS" { return "end" }
    if has_prefix(s, "SECTION ") {
        var n = len(s)
        var j: i64 = 8
        while j < n {
            var b = str_byte(s, j)
            if b < 48 || b > 57 {
                break
            }
            j = j + 1
        }
        if j > 8 {
            return "section-" + str_sub_bytes(s, 8, j)
        }
        return "section"
    }
    return "appendix"
}

// 字节是否为数字
func is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57
}

// 该位置是否为引号类字符（" ' « “）——定义式条款的判据
func is_quote_start(s: string, i: i64) -> bool {
    var n = len(s)
    if i >= n {
        return false
    }
    var b = str_byte(s, i)
    if b == 34 || b == 39 {
        return true
    }
    if b == 194 && i + 1 < n && str_byte(s, i + 1) == 171 {
        return true
    }
    if b == 226 && i + 2 < n && str_byte(s, i + 1) == 128 && str_byte(s, i + 2) == 156 {
        return true
    }
    // 日式引号「（U+300C = E3 80 8C）
    if b == 227 && i + 2 < n && str_byte(s, i + 1) == 128 && str_byte(s, i + 2) == 140 {
        return true
    }
    // 德语低引号 „（U+201E = E2 80 9E）
    if b == 226 && i + 2 < n && str_byte(s, i + 1) == 128 && str_byte(s, i + 2) == 158 {
        return true
    }
    return false
}

// 行内是否含 em dash（U+2014，含中文「——」）——标题式条款的判据
func has_em_dash(s: string) -> bool {
    var n = len(s)
    var i: i64 = 0
    while i + 2 < n {
        if str_byte(s, i) == 226 && str_byte(s, i + 1) == 128 && str_byte(s, i + 2) == 148 {
            return true
        }
        i = i + 1
    }
    return false
}

// 是否为条款起始行："N.N ..."（N 为一至多位数字，后跟空格）
// 例：1.1 / 1.10 / 4.8 / 15.2
func is_clause(s: string) -> bool {
    var n = len(s)
    if n < 4 { return false }
    if !is_digit(str_byte(s, 0)) { return false }
    var j: i64 = 0
    while j < n && is_digit(str_byte(s, j)) {
        j = j + 1
    }
    if j == 0 || j >= n || str_byte(s, j) != 46 { return false } // '.'
    j = j + 1
    var k = j
    while k < n && is_digit(str_byte(s, k)) {
        k = k + 1
    }
    if k == j { return false }          // 点后无数字
    if k >= n { return false }
    if str_byte(s, k) != 32 {
        return false                     // 数字后必须跟空格
    }
    // 增强判据：须为「引号式定义」（1.1 "Term" ...）或「含破折号的标题」（2.1 Title — ...），
    // 以排除正文折行恰好以 N.N 开头造成的幻影锚点
    return is_quote_start(s, k + 1) || has_em_dash(s)
}

// 条款锚点 id："1.10 ..." → "s-1-10"
func clause_id(s: string) -> string {
    var n = len(s)
    var j: i64 = 0
    while j < n && is_digit(str_byte(s, j)) {
        j = j + 1
    }
    var major = str_sub_bytes(s, 0, j)
    var k = j + 1
    var k0 = k
    while k < n && is_digit(str_byte(s, k)) {
        k = k + 1
    }
    var minor = str_sub_bytes(s, k0, k)
    return "s-" + major + "-" + minor
}

// ---------- 页面骨架 ----------

// 多语言表：代码与显示名（en 为权威语言；zh-cn 有中文界面；其余为英文回退页）
var g_lang_codes: table<string> = []
var g_lang_names: table<string> = []
var g_lang_banners: table<string> = []
// 非权威参考译文提示（存在译文文件时使用）
var g_lang_refnotes: table<string> = []
// 官方翻译标志（1 = 已由许可人依 §15.8 指定为官方翻译）
var g_lang_official: table<i64> = []
// 官方翻译提示（存在译文文件且官方时使用）
var g_lang_official_notes: table<string> = []

func init_langs() {
    table_push(g_lang_codes, "en")
    table_push(g_lang_names, "English")
    table_push(g_lang_banners, "")
    table_push(g_lang_refnotes, "")
    table_push(g_lang_official, 0)
    table_push(g_lang_official_notes, "")
    table_push(g_lang_codes, "zh-cn")
    table_push(g_lang_names, "中文")
    table_push(g_lang_banners, "此页为英文权威文本 —— 中文翻译尚未发布。英文版本为准（English version prevails）。<a href=\"/zh-cn/\">中文说明页</a>")
    table_push(g_lang_refnotes, "本页为 TPL 2.3 的非权威参考译文。英文版本为准（English version prevails）。")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "本页为 TPL 2.3 的官方翻译。英文版本为准（English version prevails, §15.8）。")
    table_push(g_lang_codes, "es")
    table_push(g_lang_names, "Español")
    table_push(g_lang_banners, "La traducción de esta página aún no está disponible; se muestra el texto en inglés. Prevalece la versión en inglés (§15.8).")
    table_push(g_lang_refnotes, "Esta página contiene una traducción de referencia no oficial de TPL 2.3. Prevalece el texto en inglés (§15.8).")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "Esta página es una traducción oficial de TPL 2.3. Prevalece el texto en inglés (§15.8).")
    table_push(g_lang_codes, "fr")
    table_push(g_lang_names, "Français")
    table_push(g_lang_banners, "La traduction de cette page n'est pas encore disponible ; le texte anglais est affiché. La version anglaise prévaut (§15.8).")
    table_push(g_lang_refnotes, "Cette page contient une traduction de référence non officielle de TPL 2.3. Le texte anglais prévaut (§15.8).")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "Cette page est une traduction officielle de TPL 2.3. Le texte anglais prévaut (§15.8).")
    table_push(g_lang_codes, "de")
    table_push(g_lang_names, "Deutsch")
    table_push(g_lang_banners, "Eine Übersetzung dieser Seite ist noch nicht verfügbar; der englische Text wird angezeigt. Die englische Fassung gilt (§15.8).")
    table_push(g_lang_refnotes, "Diese Seite enthält eine nicht amtliche Referenzübersetzung von TPL 2.3. Maßgeblich ist der englische Text (§15.8).")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "Diese Seite ist eine amtliche Übersetzung von TPL 2.3. Maßgeblich ist der englische Text (§15.8).")
    table_push(g_lang_codes, "ja")
    table_push(g_lang_names, "日本語")
    table_push(g_lang_banners, "このページの翻訳はまだ提供されていません。英語テキストを表示しています。英語版が優先されます（§15.8）。")
    table_push(g_lang_refnotes, "このページは TPL 2.3 の非公式参考訳です。英語原文が優先されます（§15.8）。")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "このページは TPL 2.3 の公式翻訳です。英語原文が優先されます（§15.8）。")
    table_push(g_lang_codes, "pt")
    table_push(g_lang_names, "Português")
    table_push(g_lang_banners, "A tradução desta página ainda não está disponível; o texto em inglês é exibido. A versão em inglês prevalece (§15.8).")
    table_push(g_lang_refnotes, "Esta página contém uma tradução de referência não oficial da TPL 2.3. O texto em inglês prevalece (§15.8).")
    table_push(g_lang_official, 1)
    table_push(g_lang_official_notes, "Esta página é uma tradução oficial da TPL 2.3. O texto em inglês prevalece (§15.8).")
    table_push(g_lang_codes, "ru")
    table_push(g_lang_names, "Русский")
